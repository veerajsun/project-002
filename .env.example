# Copy this file to .env.local on your server or development environment and fill in your values.
# .env.local is ignored by git. NEVER commit real credentials or private keys.
# None of these variables are exposed to the browser.

# ------------------------------------------------------------------------------
# 1. Environment & Site Origin
# ------------------------------------------------------------------------------
# In production, set NODE_ENV="production"
NODE_ENV="production"

# Your public production URL. Browser POST requests from any other origin are rejected.
SITE_ORIGIN="https://sabland.in"

# ------------------------------------------------------------------------------
# 2. SQLite Database Path (Primary Database)
# ------------------------------------------------------------------------------
# In development: defaults to ./data/sabaland.db if left unset.
# In HostKarle DirectAdmin production: must be a persistent absolute path outside
# or within your application data folder that survives deployments.
# Example: /home/YOUR_USER/data/sabaland.db
SQLITE_DB_PATH="/home/YOUR_USER/data/sabaland.db"

# ------------------------------------------------------------------------------
# 3. Google Sheets Integration (Secondary Order Copy)
# ------------------------------------------------------------------------------
# 1. Share your target Google Sheet with this service account email as "Editor".
# 2. Extract your private_key and client_email from your downloaded Google Cloud service account JSON.
# 3. Spreadsheet ID is extracted from URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@example-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nexample_private_key\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="example_spreadsheet_id"
GOOGLE_SHEET_TAB_NAME="Orders"
