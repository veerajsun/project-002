# Copy this file to  .env.local  and fill in YOUR values.
# .env.local is ignored by git. NEVER put real passwords in this example file.
# Nothing here is visible to the browser (none of these start with NEXT_PUBLIC_).

# PostgreSQL connection string.
#   Local Windows PostgreSQL:  postgresql://postgres:YOUR_PASSWORD@localhost:5432/sabland
#   Hosted PostgreSQL (e.g. Neon): copy the connection string from its dashboard (it ends with ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sabland"

# Optional but recommended: the exact address of your website. Browser POST requests from any
# other website are then refused. Use your real https address once the site is online.
SITE_ORIGIN="http://localhost:3000"

# SQLite persistent database path (defaults to ./data/sabaland.db if unset in development)
SQLITE_DB_PATH="./data/sabaland.db"

# Google Sheets Integration (Service Account)
# 1. Share your target Google Sheet with this service account email as "Editor".
# 2. Extract your private key and client email from your downloaded Google Cloud service account JSON.
# 3. Spreadsheet ID is found in the URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@example-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nexample_private_key\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="example_spreadsheet_id"
GOOGLE_SHEET_TAB_NAME="Orders"
